@* Inline SVG icons (24×24, stroked). Drawn for this app; no external icon set is loaded. *@
<svg class="icon @Class @(Filled ? "filled" : "")" viewBox="0 0 24 24" aria-hidden="true">
    @switch (Name)
    {
        case "lock":
            <rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4.2-4.2" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "copy":
            <rect x="9" y="9" width="11" height="11" rx="2" /><path d="M15 5H7a2 2 0 0 0-2 2v8" />
            break;
        case "eye":
            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" />
            break;
        case "eye-off":
            <path d="M3 3l18 18" /><path d="M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.6 17.6 0 0 1-3.2 4.1M6.6 6.6C3.9 8.3 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6" /><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
            break;
        case "star":
            <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8L3.5 9.7l5.9-.9z" />
            break;
        case "trash":
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3" />
            break;
        case "edit":
            <path d="M4 20h4L19 9l-4-4L4 16v4z" /><path d="M14 6l4 4" />
            break;
        case "settings":
            <path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1" /><circle cx="15" cy="6" r="2" /><circle cx="9" cy="12" r="2" /><circle cx="17" cy="18" r="2" />
            break;
        case "server":
            <rect x="3" y="4" width="18" height="7" rx="1.5" /><rect x="3" y="13" width="18" height="7" rx="1.5" /><path d="M7 7.5h.01M7 16.5h.01" />
            break;
        case "login":
            <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
            break;
        case "note":
            <path d="M6 3h9l4 4v14H6z" /><path d="M14 3v5h5M9 13h7M9 17h5" />
            break;
        case "key":
            <circle cx="8" cy="15" r="4" /><path d="M11 12l9-9M17 6l3 3M14 9l2 2" />
            break;
        case "terminal":
            <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 9l3 3-3 3M13 15h4" />
            break;
        case "x":
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case "check":
            <path d="M5 12.5l4.5 4.5L19 7.5" />
            break;
        case "shield":
            <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" /><path d="M9 12l2 2 4-4" />
            break;
        case "archive":
            <rect x="3" y="4" width="18" height="5" rx="1" /><path d="M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9M10 13h4" />
            break;
        case "refresh":
            <path d="M20 11a8 8 0 1 0-2.3 5.7" /><path d="M20 4v7h-7" />
            break;
        case "dice":
            <rect x="4" y="4" width="16" height="16" rx="3" /><path d="M8.5 8.5h.01M15.5 15.5h.01M15.5 8.5h.01M8.5 15.5h.01M12 12h.01" />
            break;
        case "arrow-left":
            <path d="M19 12H5M11 6l-6 6 6 6" />
            break;
        case "tag":
            <path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9z" /><circle cx="8" cy="8" r="1.5" />
            break;
        case "layers":
            <path d="M12 3l9 5-9 5-9-5z" /><path d="M3 13l9 5 9-5" />
            break;
        case "alert":
            <path d="M12 3l10 18H2z" /><path d="M12 10v4M12 17.5h.01" />
            break;
        case "printer":
            <path d="M7 9V3h10v6" /><rect x="3" y="9" width="18" height="8" rx="2" /><path d="M7 14h10v7H7z" />
            break;
        case "restore":
            <path d="M4 12a8 8 0 1 0 2.3-5.7" /><path d="M4 4v5h5" /><path d="M12 8v4l3 2" />
            break;
        case "contrast":
            <circle cx="12" cy="12" r="8.5" /><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" />
            break;
        default:
            <circle cx="12" cy="12" r="4" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public bool Filled { get; set; }
    [Parameter] public string? Class { get; set; }
}
