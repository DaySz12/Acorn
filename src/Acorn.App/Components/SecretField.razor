@* Masked by default. The value is shown only while AppState holds it (controller timer hides it again). *@
@inherits AppStateView
@inject EntryController Entries

<div class="field-row">
    <span class="label">@Label</span>
    @if (State.RevealedValue(Secret) is { } value)
    {
        <span class="value mono revealed">@value</span>
    }
    else
    {
        <span class="value secret">••••••••••</span>
    }
    <span class="actions">
        <button type="button" class="icon-btn" title="@(State.IsRevealed(Secret) ? "ซ่อน" : "แสดงชั่วคราว")" @onclick="ToggleAsync">
            <Icon Name="@(State.IsRevealed(Secret) ? "eye-off" : "eye")" Class="sm" />
        </button>
        <CopyButton OnCopy="() => Entries.CopySecretAsync(Secret)" Title="คัดลอก (ล้าง clipboard อัตโนมัติ)" />
    </span>
</div>

@code {
    [Parameter, EditorRequired] public SecretRef Secret { get; set; }
    [Parameter] public string Label { get; set; } = "Password";

    private async Task ToggleAsync()
    {
        if (State.IsRevealed(Secret))
        {
            Entries.HideSecret(Secret);
        }
        else
        {
            await Entries.RevealSecretAsync(Secret);
        }
    }
}
