@* Options are bound to AppState.Generator; generation happens in EntryController (RandomNumberGenerator). *@
@inherits AppStateView
@inject EntryController Entries

<div class="generator">
    <div class="row">
        <Icon Name="dice" />
        <strong class="grow">สุ่มรหัสผ่าน</strong>
        <button type="button" class="btn sm" @onclick="Generate"><Icon Name="refresh" Class="sm" /> สุ่มใส่ช่องรหัสผ่าน</button>
    </div>
    <div class="row">
        <span class="muted">ความยาว</span>
        <input type="range" min="@PasswordGeneratorViewModel.MinLength" max="@PasswordGeneratorViewModel.MaxLength" @bind="G.Length" @bind:event="oninput" />
        <span class="mono">@G.Length</span>
    </div>
    <div class="row wrap">
        <label class="checkbox"><input type="checkbox" @bind="G.Lowercase" /> a-z</label>
        <label class="checkbox"><input type="checkbox" @bind="G.Uppercase" /> A-Z</label>
        <label class="checkbox"><input type="checkbox" @bind="G.Digits" /> 0-9</label>
        <label class="checkbox"><input type="checkbox" @bind="G.Symbols" /> !@@#$</label>
        <label class="checkbox"><input type="checkbox" @bind="G.ExcludeAmbiguous" /> ไม่ใช้ตัวที่สับสน (I l 1 O 0)</label>
    </div>
    @if (_error is not null)
    {
        <p class="form-error">@_error</p>
    }
</div>

@code {
    private string? _error;

    private PasswordGeneratorViewModel G => State.Generator;

    private void Generate() => _error = Entries.GeneratePasswordForEditor().Error;
}
